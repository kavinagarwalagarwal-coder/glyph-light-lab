<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app talk to Nothing's Glyph service. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nothing's Glyph service lives in this package; Android 11+ hides other apps unless asked. -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
    </queries>

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- "test" is Nothing's debug key; it works while Glyph debugging is switched on. -->
        <meta-data android:name="NothingKey" android:value="test" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
